server {
    listen {{ nginx_api_listen_port }};
    listen [::]:{{ nginx_api_listen_port }};

    server_name {{ nginx_api_server_name }};

    access_log /var/log/nginx/api-access.log;
    error_log /var/log/nginx/api-error.log;

    location / {
        proxy_pass http://{{ nginx_api_backend_host }}:{{ nginx_api_backend_port }};

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout {{ nginx_api_proxy_connect_timeout }};
        proxy_read_timeout {{ nginx_api_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_api_proxy_send_timeout }};
    }
}
